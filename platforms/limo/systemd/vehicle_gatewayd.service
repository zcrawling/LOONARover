[Unit]
Description=LOONAR Vehicle Gateway
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vehicle_gatewayd --runtime-dir %t/loonar/vehicle-gateway
RuntimeDirectory=loonar
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
