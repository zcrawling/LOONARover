+void LimoDriver::publishWheelOdometers(double stamp, std::int32_t left_mm, std::int32_t right_mm) {
+    sensor_msgs::msg::JointState message;
+    message.header.stamp = rclcpp::Time(RCL_S_TO_NS(stamp));
+    message.header.frame_id = base_frame_;
+    // CAN 0x311: cumulative left/right chassis wheel odometers, millimetres.
+    message.name = {"left_wheel_odometer_m", "right_wheel_odometer_m"};
+    message.position = {static_cast<double>(left_mm) / 1000.0,
+                        static_cast<double>(right_mm) / 1000.0};
+    wheel_odometer_publisher_->publish(message);
+}
