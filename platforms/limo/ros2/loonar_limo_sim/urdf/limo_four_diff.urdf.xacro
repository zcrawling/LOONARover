<?xml version="1.0"?>
<robot name="loonar_limo_four_diff" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- SIL geometry. ToF mount values are intentionally simulation-only until LIMO is measured. -->
  <xacro:arg name="tof_x_m" default="0.08"/>
  <xacro:arg name="tof_y_m" default="0.0"/>
  <xacro:arg name="tof_z_m" default="0.10"/>
  <!-- Physical values copied from AgileX's four-differential Xacro. -->
  <xacro:property name="wheelbase" value="0.20"/>
  <xacro:property name="track" value="0.13"/>
  <xacro:property name="wheel_radius" value="0.045"/>
  <xacro:property name="wheel_width" value="0.045"/>

  <link name="base_link">
    <inertial><origin xyz="0 0 0"/><mass value="2.1557"/><inertia ixx="0.24" ixy="0" ixz="0" iyy="0.96" iyz="0" izz="0.96"/></inertial>
    <visual><origin xyz="0 0 -0.15" rpy="0 0 1.57079632679"/><geometry><mesh filename="model://loonar_limo/meshes/limo_base.dae"/></geometry></visual>
    <collision><geometry><box size="0.13 0.12 0.10"/></geometry></collision>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.01055" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.01055"/></inertial>
      <visual><geometry><mesh filename="model://loonar_limo/meshes/limo_wheel.dae"/></geometry></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} -0.10"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="front_left" x="${wheelbase/2}" y="${track/2}"/>
  <xacro:wheel name="front_right" x="${wheelbase/2}" y="${-track/2}"/>
  <xacro:wheel name="rear_left" x="${-wheelbase/2}" y="${track/2}"/>
  <xacro:wheel name="rear_right" x="${-wheelbase/2}" y="${-track/2}"/>

  <link name="tof_link"><visual><geometry><box size="0.060 0.018 0.012"/></geometry><material name="blue"><color rgba="0.1 0.2 0.8 1"/></material></visual></link>
  <joint name="base_to_tof" type="fixed"><parent link="base_link"/><child link="tof_link"/><origin xyz="$(arg tof_x_m) $(arg tof_y_m) $(arg tof_z_m)" rpy="0 0 0"/></joint>
  <link name="tof_depth_frame"/>
  <joint name="tof_to_depth" type="fixed"><parent link="tof_link"/><child link="tof_depth_frame"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="tof_depth_optical_frame"/>
  <joint name="depth_to_optical" type="fixed"><parent link="tof_depth_frame"/><child link="tof_depth_optical_frame"/><origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/></joint>

  <gazebo reference="front_left_wheel_link"><mu1>10</mu1><mu2>10</mu2><kp>10000000.0</kp><kd>1.0</kd><minDepth>0.01</minDepth><fdir1>1 0 0</fdir1><maxContacts>64</maxContacts></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>10</mu1><mu2>10</mu2><kp>10000000.0</kp><kd>1.0</kd><minDepth>0.01</minDepth><fdir1>1 0 0</fdir1><maxContacts>64</maxContacts></gazebo>
  <gazebo reference="rear_left_wheel_link"><mu1>10</mu1><mu2>10</mu2><kp>10000000.0</kp><kd>1.0</kd><minDepth>0.01</minDepth><fdir1>1 0 0</fdir1><maxContacts>64</maxContacts></gazebo>
  <gazebo reference="rear_right_wheel_link"><mu1>10</mu1><mu2>10</mu2><kp>10000000.0</kp><kd>1.0</kd><minDepth>0.01</minDepth><fdir1>1 0 0</fdir1><maxContacts>64</maxContacts></gazebo>

  <!-- The Humble-era AgileX model uses the ROS 2 plugin's two wheel-pair mode. -->
  <gazebo>
    <plugin name="loonar_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace><remapping>odom:=wheel/odom</remapping></ros>
      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>front_left_wheel_joint</left_joint><right_joint>front_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint><right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.172</wheel_separation><wheel_diameter>0.09</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque><max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame>
      <!-- gazebo_ros_diff_drive accepts 0=encoder, 1=world (not strings). -->
      <odometry_source>0</odometry_source><publish_odom>true</publish_odom><publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf><publish_wheel_joint_state>true</publish_wheel_joint_state>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="base_imu" type="imu"><always_on>true</always_on><update_rate>100</update_rate>
      <plugin name="loonar_imu" filename="libgazebo_ros_imu_sensor.so"><ros><namespace>/</namespace><remapping>~/out:=imu</remapping></ros><frame_name>base_link</frame_name></plugin>
    </sensor>
  </gazebo>
  <gazebo reference="tof_link">
    <sensor name="tof_depth" type="depth"><always_on>true</always_on><update_rate>30</update_rate><visualize>false</visualize>
      <camera name="tof"><horizontal_fov>1.1849</horizontal_fov><image><width>640</width><height>400</height><format>R8G8B8</format></image><clip><near>0.30</near><far>3.0</far></clip></camera>
      <plugin name="loonar_tof" filename="libgazebo_ros_camera.so">
        <ros><namespace>/tof/sim</namespace><remapping>~/image_depth:=image_depth</remapping><remapping>~/camera_info:=camera_info</remapping><remapping>~/points:=points</remapping></ros>
        <camera_name>tof</camera_name><frame_name>tof_depth_optical_frame</frame_name><hack_baseline>0.04</hack_baseline><min_depth>0.30</min_depth><max_depth>3.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
