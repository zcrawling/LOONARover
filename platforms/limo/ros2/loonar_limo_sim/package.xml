  <version>0.1.0</version>
  <description>Four-wheel-differential LIMO SIL with the LOONAR ToF ROS interface.</description>
  <maintainer email="noreply@example.invalid">LOONAR</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
