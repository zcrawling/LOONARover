table inet loonar_link_policy {
    chain input {
        type filter hook input priority -10; policy accept;
        iifname "lo" return
        ip saddr != @GCS_IP@ tcp dport { 7443, 7444, 7445 } counter drop
        meta nfproto ipv6 tcp dport { 7443, 7444, 7445 } counter drop
        ip saddr != @GCS_IP@ udp dport 7400-7649 counter drop
        udp dport { 6101, 6102 } counter drop
    }
    chain output {
        type filter hook output priority -10; policy accept;
        oifname "lo" return
        ip daddr != @GCS_IP@ tcp sport { 7443, 7444, 7445 } counter drop
        ip daddr != @GCS_IP@ udp dport { 5600, 5601 } counter drop
        ip daddr != @GCS_IP@ udp dport 7400-7649 counter drop
        ip daddr != { @STATUS_IPS@ } udp dport { 6101, 6102 } counter drop
    }
}
