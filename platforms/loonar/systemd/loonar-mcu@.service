[Unit]
Description=LOONAR %i MCU v2 serial owner
After=loonar-cfs.service vehicle_gatewayd.service
ConditionPathExists=/etc/loonar/mcu-registry.json

[Service]
Type=simple
User=loonar
Group=loonar
SupplementaryGroups=dialout
RuntimeDirectory=loonar/mcu
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=PYTHONPATH=/opt/loonar/current/lib/python
ExecStart=/usr/bin/python3 -m mcu_v2.backend --role %i
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0027

[Install]
WantedBy=multi-user.target
