[Unit]
Description=LOONAR vehicle command gateway
After=network.target

[Service]
Type=simple
User=loonar
Group=loonar
RuntimeDirectory=loonar/vehicle-gateway
RuntimeDirectoryMode=0750
ExecStart=/opt/loonar/current/bin/vehicle_gatewayd --runtime-dir /run/loonar/vehicle-gateway
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=loonar-core.target
