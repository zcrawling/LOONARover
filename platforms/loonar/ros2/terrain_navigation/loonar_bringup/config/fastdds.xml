<?xml version="1.0" encoding="UTF-8"?>
<!-- Full-resolution 640x480 float images exceed Fast DDS's default 512 KiB
     shared-memory segment. Keep image delivery on the Pi in a 64 MiB segment;
     UDP remains available for discovery and ground-station subscribers. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>loonar_shm</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>loonar_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="loonar_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>loonar_shm</transport_id>
        <transport_id>loonar_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
