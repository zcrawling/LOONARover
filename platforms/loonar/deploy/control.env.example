# Preparation only. This file neither implements the Control backend nor flashes firmware.
CONTROL_TRANSPORT=usb-cdc
CONTROL_DEVICE=/dev/serial/by-id/REPLACE_WITH_CONTROL_TEENSY_ID
# USB CDC line coding; actual USB throughput is not a physical UART baud rate.
CONTROL_BAUD=2000000
