PAYLOAD_DEVICE=/dev/serial/by-id/REPLACE_WITH_PAYLOAD_TEENSY_ID
PAYLOAD_LOG_DIR=/var/lib/loonar/payload

# Both commands are mandatory: START must physically enable USB/sensor power,
# and STOP must physically remove it. Use the exact command for the installed
# switched hub or GPIO load switch. Arguments are parsed without a shell.
# Example only (hub/location/port MUST be verified on the rover):
PAYLOAD_POWER_ON_COMMAND=/usr/sbin/uhubctl -l REPLACE_HUB -p REPLACE_PORT -a on
PAYLOAD_POWER_OFF_COMMAND=/usr/sbin/uhubctl -l REPLACE_HUB -p REPLACE_PORT -a off
